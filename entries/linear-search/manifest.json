{
  "manifest_version": "1.0",
  "server": {
    "name": "linear-search",
    "url": "https://mcp.linear.app/mcp",
    "transport": "streamable-http"
  },
  "display": {
    "name": "Linear · Search",
    "description": "Search Linear issues from inside ChatGPT or Claude, then open the result inline.",
    "icon": "https://cdn.mcp-apps.directory/icons/linear.svg",
    "categories": [
      "project-management"
    ]
  },
  "auth": {
    "type": "oauth2",
    "scopes": [
      "read",
      "write"
    ],
    "discoveryUrl": "https://mcp.linear.app/.well-known/oauth-authorization-server"
  },
  "tools": [
    {
      "name": "search_issues",
      "title": "Search Linear issues",
      "description": "Search Linear issues by full-text query. Returns up to 25 matches with team, state, and assignee.",
      "inputSchema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 25
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "issues"
        ],
        "properties": {
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "identifier",
                "title",
                "url"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "identifier": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "state": {
                  "type": "string"
                },
                "team": {
                  "type": "string"
                },
                "assignee": {
                  "type": "string"
                },
                "priority": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4
                }
              }
            }
          }
        }
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "read"
          ]
        }
      ],
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true
      }
    }
  ]
}
