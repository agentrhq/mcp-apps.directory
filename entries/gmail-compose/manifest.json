{
  "manifest_version": "1.0",
  "server": {
    "name": "gmail-compose",
    "url": "https://gmailmcp.googleapis.com/mcp/v1",
    "transport": "streamable-http"
  },
  "display": {
    "name": "Gmail · Compose draft",
    "description": "Compose a Gmail draft from the chat. Returns a preview card with subject and recipients.",
    "icon": "https://cdn.mcp-apps.directory/icons/gmail.svg",
    "categories": [
      "comms"
    ]
  },
  "auth": {
    "type": "oauth2",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.compose"
    ]
  },
  "tools": [
    {
      "name": "create_draft",
      "title": "Create a Gmail draft",
      "description": "Create a draft email in the user's Gmail account. Does not send.",
      "inputSchema": {
        "type": "object",
        "required": [
          "to",
          "subject",
          "body"
        ],
        "properties": {
          "to": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            },
            "minItems": 1,
            "maxItems": 100
          },
          "cc": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            }
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 998
          },
          "body": {
            "type": "string",
            "maxLength": 100000
          },
          "html": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "draft"
        ],
        "properties": {
          "draft": {
            "type": "object",
            "required": [
              "id",
              "url",
              "to",
              "subject"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "to": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "subject": {
                "type": "string"
              },
              "snippet": {
                "type": "string"
              }
            }
          }
        }
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "https://www.googleapis.com/auth/gmail.compose"
          ]
        }
      ],
      "annotations": {
        "destructiveHint": false
      }
    }
  ]
}
