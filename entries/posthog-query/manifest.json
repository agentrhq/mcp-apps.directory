{
  "manifest_version": "1.0",
  "server": {
    "name": "posthog-query",
    "url": "https://mcp.posthog.com/mcp",
    "transport": "streamable-http"
  },
  "display": {
    "name": "PostHog · Run query",
    "description": "Run a HogQL query and render the result as a tabular card inside the chat.",
    "icon": "https://cdn.mcp-apps.directory/icons/posthog.svg",
    "categories": [
      "data"
    ]
  },
  "auth": {
    "type": "api-key",
    "header": "Authorization",
    "prefix": "Bearer ",
    "envVar": "POSTHOG_PERSONAL_API_KEY"
  },
  "tools": [
    {
      "name": "run_query",
      "title": "Run a HogQL query",
      "description": "Execute a HogQL query against a PostHog project. Returns up to 200 rows.",
      "inputSchema": {
        "type": "object",
        "required": [
          "project_id",
          "query"
        ],
        "properties": {
          "project_id": {
            "type": "integer",
            "minimum": 1
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "object",
            "required": [
              "columns",
              "rows"
            ],
            "properties": {
              "columns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array"
                }
              },
              "row_count": {
                "type": "integer"
              },
              "elapsed_ms": {
                "type": "integer"
              }
            }
          }
        }
      },
      "securitySchemes": [
        {
          "type": "api-key"
        }
      ],
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true
      }
    }
  ]
}
