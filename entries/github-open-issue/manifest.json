{
  "manifest_version": "1.0",
  "server": {
    "name": "github-open-issue",
    "url": "https://api.githubcopilot.com/mcp/",
    "transport": "streamable-http"
  },
  "display": {
    "name": "GitHub · Open issue",
    "description": "Open a GitHub issue in any repository the user has access to. Renders a card with the issue number and link.",
    "icon": "https://cdn.mcp-apps.directory/icons/github.svg",
    "categories": [
      "dev-tools"
    ]
  },
  "auth": {
    "type": "oauth2",
    "scopes": [
      "repo",
      "issues:write"
    ]
  },
  "tools": [
    {
      "name": "create_issue",
      "title": "Open a GitHub issue",
      "description": "Open a new issue in `owner/repo`. Supports labels and assignees.",
      "inputSchema": {
        "type": "object",
        "required": [
          "owner",
          "repo",
          "title"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "body": {
            "type": "string",
            "maxLength": 65536
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assignees": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "issue"
        ],
        "properties": {
          "issue": {
            "type": "object",
            "required": [
              "number",
              "url",
              "title",
              "state"
            ],
            "properties": {
              "number": {
                "type": "integer"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "title": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "open",
                  "closed"
                ]
              },
              "repo_full_name": {
                "type": "string"
              }
            }
          }
        }
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "repo"
          ]
        }
      ],
      "annotations": {
        "destructiveHint": false
      }
    }
  ]
}
