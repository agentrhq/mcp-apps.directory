{
  "manifest_version": "1.0",
  "server": {
    "name": "github-open-issue",
    "url": "https://api.githubcopilot.com/mcp/",
    "transport": "streamable-http"
  },
  "display": {
    "name": "GitHub · Open issue",
    "description": "Open a GitHub issue in any repository the user has access to. Renders a card with the issue number and link.",
    "icon": "https://cdn.mcp-apps.directory/icons/github.svg",
    "categories": ["dev-tools"]
  },
  "auth": {
    "type": "oauth2",
    "scopes": ["repo", "issues:write"]
  },
  "tools": [
    {
      "name": "create_issue",
      "title": "Open a GitHub issue",
      "description": "Open a new issue in `owner/repo`. Supports labels and assignees.",
      "inputSchema": {
        "type": "object",
        "required": ["owner", "repo", "title"],
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "repo": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1, "maxLength": 256 },
          "body": { "type": "string", "maxLength": 65536 },
          "labels": { "type": "array", "items": { "type": "string" } },
          "assignees": { "type": "array", "items": { "type": "string" } }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["issue"],
        "properties": {
          "issue": {
            "type": "object",
            "required": ["number", "url", "title", "state"],
            "properties": {
              "number": { "type": "integer" },
              "url": { "type": "string", "format": "uri" },
              "title": { "type": "string" },
              "state": { "type": "string", "enum": ["open", "closed"] },
              "repo_full_name": { "type": "string" }
            }
          }
        }
      },
      "securitySchemes": [{ "type": "oauth2", "scopes": ["repo"] }],
      "annotations": { "destructiveHint": false },
      "_meta": {
        "ui": { "resourceUri": "ui://widget/github-open-issue.html", "visibility": ["model", "app"] }
      }
    }
  ],
  "resources": [
    {
      "uri": "ui://widget/github-open-issue.html",
      "mimeType": "text/html;profile=mcp-app",
      "text": "<!doctype html><html><head><meta charset=\"utf-8\"><title>GitHub issue</title><style>body{font:14px -apple-system,sans-serif;margin:0;padding:16px;background:#fff;color:#1f2328}.card{border:1px solid #d0d7de;border-radius:6px;padding:16px}.head{display:flex;align-items:center;gap:8px}.dot{width:14px;height:14px;border-radius:50%;background:#1a7f37;display:inline-block}.num{color:#656d76;font-weight:600}.title{font-weight:600;font-size:16px;margin:6px 0}.repo{color:#0969da;font-family:ui-monospace,monospace;font-size:12px}a{color:inherit;text-decoration:none}</style></head><body><div id=\"root\">Opening...</div><script>function render(d){const i=d?.issue;if(!i)return;document.getElementById('root').innerHTML=`<a class=\"card\" href=\"${i.url}\" target=\"_blank\"><div class=\"head\"><span class=\"dot\"></span><span class=\"num\">#${i.number}</span><span class=\"repo\">${i.repo_full_name||''}</span></div><div class=\"title\">${i.title}</div></a>`}window.openai?.toolOutput&&render(window.openai.toolOutput);window.addEventListener('message',e=>{if(e.data?.type==='ui/notifications/tool-result')render(e.data.params?.structuredContent)});</script></body></html>",
      "_meta": {
        "ui": {
          "domain": "github-open-issue.widget.mcp-apps.directory",
          "prefersBorder": true,
          "csp": { "connectDomains": ["api.github.com"], "resourceDomains": ["github.com"] }
        }
      }
    }
  ]
}
