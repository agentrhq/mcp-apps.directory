{
  "manifest_version": "1.0",
  "server": {
    "name": "resend-send",
    "url": "http://127.0.0.1:3000/mcp",
    "transport": "streamable-http"
  },
  "display": {
    "name": "Resend · Send email",
    "description": "Send a transactional email via Resend and render the confirmation card.",
    "icon": "https://cdn.mcp-apps.directory/icons/resend.svg",
    "categories": [
      "comms"
    ]
  },
  "auth": {
    "type": "api-key",
    "header": "Authorization",
    "prefix": "Bearer ",
    "envVar": "RESEND_API_KEY"
  },
  "tools": [
    {
      "name": "send_email",
      "title": "Send an email",
      "description": "Send a transactional email via Resend. Supports plain text and HTML.",
      "inputSchema": {
        "type": "object",
        "required": [
          "from",
          "to",
          "subject"
        ],
        "properties": {
          "from": {
            "type": "string",
            "format": "email"
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            },
            "minItems": 1,
            "maxItems": 50
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 998
          },
          "text": {
            "type": "string",
            "maxLength": 100000
          },
          "html": {
            "type": "string",
            "maxLength": 200000
          },
          "reply_to": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "object",
            "required": [
              "id",
              "from",
              "to",
              "subject"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "subject": {
                "type": "string"
              },
              "delivery_url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      },
      "securitySchemes": [
        {
          "type": "api-key"
        }
      ],
      "annotations": {
        "destructiveHint": false
      }
    }
  ]
}
