{
  "manifest_version": "1.0",
  "server": {
    "name": "slack-quick-post",
    "url": "https://mcp.slack.com/mcp",
    "transport": "streamable-http"
  },
  "display": {
    "name": "Slack · Quick post",
    "description": "Post a message to a Slack channel with live preview before sending.",
    "icon": "https://cdn.mcp-apps.directory/icons/slack.svg",
    "categories": [
      "comms"
    ]
  },
  "auth": {
    "type": "oauth2",
    "scopes": [
      "chat:write",
      "channels:read"
    ]
  },
  "tools": [
    {
      "name": "post_message",
      "title": "Post to Slack",
      "description": "Post a message to a Slack channel. Shows a live preview before the actual send.",
      "inputSchema": {
        "type": "object",
        "required": [
          "channel",
          "text"
        ],
        "properties": {
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40000
          },
          "thread_ts": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "object",
            "required": [
              "ts",
              "channel",
              "text",
              "permalink"
            ],
            "properties": {
              "ts": {
                "type": "string"
              },
              "channel": {
                "type": "string"
              },
              "channel_name": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "permalink": {
                "type": "string",
                "format": "uri"
              },
              "user_name": {
                "type": "string"
              }
            }
          }
        }
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "chat:write"
          ]
        }
      ],
      "annotations": {
        "destructiveHint": false
      }
    }
  ]
}
