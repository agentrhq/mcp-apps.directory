{
  "manifest_version": "1.0",
  "server": {
    "name": "vercel-deployment",
    "url": "https://mcp.vercel.com",
    "transport": "streamable-http"
  },
  "display": {
    "name": "Vercel · View deployment",
    "description": "Look up a Vercel deployment by id and render a status card with branch, commit, and live URL.",
    "icon": "https://cdn.mcp-apps.directory/icons/vercel.svg",
    "categories": [
      "dev-tools"
    ]
  },
  "auth": {
    "type": "oauth2",
    "scopes": [
      "read:deployments"
    ]
  },
  "tools": [
    {
      "name": "get_deployment",
      "title": "View a Vercel deployment",
      "description": "Fetch a deployment by id. Returns status, branch, commit, and the production URL when available.",
      "inputSchema": {
        "type": "object",
        "required": [
          "deployment_id"
        ],
        "properties": {
          "deployment_id": {
            "type": "string",
            "pattern": "^dpl_[A-Za-z0-9]+$"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "deployment"
        ],
        "properties": {
          "deployment": {
            "type": "object",
            "required": [
              "id",
              "state",
              "url"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "READY",
                  "BUILDING",
                  "ERROR",
                  "QUEUED",
                  "CANCELED"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "project": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "commit_sha": {
                "type": "string"
              },
              "commit_message": {
                "type": "string"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "read:deployments"
          ]
        }
      ],
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true
      }
    }
  ]
}
