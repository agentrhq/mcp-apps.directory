{
  "manifest_version": "1.0",
  "server": {
    "name": "notion-quick-page",
    "url": "https://mcp.notion.com/mcp",
    "transport": "streamable-http"
  },
  "display": {
    "name": "Notion · Quick page",
    "description": "Create a Notion page from a prompt without leaving the chat. Returns a preview card with the page URL.",
    "icon": "https://cdn.mcp-apps.directory/icons/notion.svg",
    "categories": [
      "content"
    ]
  },
  "auth": {
    "type": "oauth2",
    "scopes": [
      "insert_content",
      "read_content"
    ],
    "discoveryUrl": "https://mcp.notion.com/.well-known/oauth-authorization-server"
  },
  "tools": [
    {
      "name": "create_page",
      "title": "Create a Notion page",
      "description": "Create a new Notion page in a workspace the user has access to. Optionally provide a parent database id.",
      "inputSchema": {
        "type": "object",
        "required": [
          "title",
          "content_markdown"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "content_markdown": {
            "type": "string",
            "maxLength": 50000
          },
          "parent_id": {
            "type": "string",
            "description": "Optional Notion page or database id."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "page"
        ],
        "properties": {
          "page": {
            "type": "object",
            "required": [
              "id",
              "url",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "title": {
                "type": "string"
              },
              "cover": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "insert_content"
          ]
        }
      ],
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false
      }
    }
  ]
}
