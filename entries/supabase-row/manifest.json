{
  "manifest_version": "1.0",
  "server": {
    "name": "supabase-row",
    "url": "https://mcp.supabase.com/mcp",
    "transport": "streamable-http"
  },
  "display": {
    "name": "Supabase · Read row",
    "description": "Fetch a row by primary key from any Supabase table and render the field values as a card.",
    "icon": "https://cdn.mcp-apps.directory/icons/supabase.svg",
    "categories": [
      "data"
    ]
  },
  "auth": {
    "type": "api-key",
    "header": "apikey",
    "envVar": "SUPABASE_SERVICE_ROLE_KEY"
  },
  "tools": [
    {
      "name": "read_row",
      "title": "Read a Supabase row",
      "description": "Read a single row from a table by primary key. Returns all selected columns.",
      "inputSchema": {
        "type": "object",
        "required": [
          "project_url",
          "table",
          "key_column",
          "key_value"
        ],
        "properties": {
          "project_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[a-z0-9]+\\.supabase\\.co"
          },
          "table": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "key_column": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "key_value": {
            "type": [
              "string",
              "integer"
            ]
          },
          "select": {
            "type": "string",
            "default": "*"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "row"
        ],
        "properties": {
          "row": {
            "type": "object",
            "required": [
              "fields"
            ],
            "properties": {
              "table": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      },
      "securitySchemes": [
        {
          "type": "api-key"
        }
      ],
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true
      }
    }
  ]
}
