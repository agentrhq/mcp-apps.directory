{
  "manifest_version": "1.0",
  "server": {
    "name": "figma-comment",
    "url": "https://mcp.figma.com/mcp",
    "transport": "streamable-http"
  },
  "display": {
    "name": "Figma · Comment on file",
    "description": "Add a comment to a Figma file or specific node. Returns a clickable card linking to the comment.",
    "icon": "https://cdn.mcp-apps.directory/icons/figma.svg",
    "categories": [
      "content"
    ]
  },
  "auth": {
    "type": "oauth2",
    "scopes": [
      "file_comments:write",
      "file_content:read"
    ]
  },
  "tools": [
    {
      "name": "add_comment",
      "title": "Comment on a Figma file",
      "description": "Post a comment on a Figma file. Optionally anchor to a specific node id.",
      "inputSchema": {
        "type": "object",
        "required": [
          "file_key",
          "message"
        ],
        "properties": {
          "file_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "node_id": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "comment"
        ],
        "properties": {
          "comment": {
            "type": "object",
            "required": [
              "id",
              "url",
              "message"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "message": {
                "type": "string"
              },
              "file_name": {
                "type": "string"
              }
            }
          }
        }
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "file_comments:write"
          ]
        }
      ],
      "annotations": {
        "destructiveHint": false
      }
    }
  ]
}
