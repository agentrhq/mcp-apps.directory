{
  "manifest_version": "1.0",
  "server": {
    "name": "figma-comment",
    "url": "https://mcp.figma.com/mcp",
    "transport": "streamable-http"
  },
  "display": {
    "name": "Figma · Comment on file",
    "description": "Add a comment to a Figma file or specific node. Returns a clickable card linking to the comment.",
    "icon": "https://cdn.mcp-apps.directory/icons/figma.svg",
    "categories": ["content"]
  },
  "auth": {
    "type": "oauth2",
    "scopes": ["file_comments:write", "file_content:read"]
  },
  "tools": [
    {
      "name": "add_comment",
      "title": "Comment on a Figma file",
      "description": "Post a comment on a Figma file. Optionally anchor to a specific node id.",
      "inputSchema": {
        "type": "object",
        "required": ["file_key", "message"],
        "properties": {
          "file_key": { "type": "string", "pattern": "^[A-Za-z0-9]+$" },
          "message": { "type": "string", "minLength": 1, "maxLength": 8000 },
          "node_id": { "type": "string" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["comment"],
        "properties": {
          "comment": {
            "type": "object",
            "required": ["id", "url", "message"],
            "properties": {
              "id": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "message": { "type": "string" },
              "file_name": { "type": "string" }
            }
          }
        }
      },
      "securitySchemes": [{ "type": "oauth2", "scopes": ["file_comments:write"] }],
      "annotations": { "destructiveHint": false },
      "_meta": {
        "ui": { "resourceUri": "ui://widget/figma-comment.html", "visibility": ["model", "app"] }
      }
    }
  ],
  "resources": [
    {
      "uri": "ui://widget/figma-comment.html",
      "mimeType": "text/html;profile=mcp-app",
      "text": "<!doctype html><html><head><meta charset=\"utf-8\"><title>Figma comment</title><style>body{font:14px -apple-system,sans-serif;margin:0;padding:20px;color:#1e1e1e;background:#fff}.card{border:1px solid #e5e5e5;border-radius:12px;padding:16px}.head{display:flex;align-items:center;gap:8px;margin-bottom:10px}.dot{width:10px;height:10px;border-radius:50%;background:#0acf83}.title{font-weight:600}.msg{color:#444;line-height:1.4;margin:8px 0}.link{font-family:ui-monospace,monospace;font-size:12px;color:#888}a{color:inherit;text-decoration:none}</style></head><body><div id=\"root\">Posting...</div><script>function render(d){const c=d?.comment;if(!c)return;document.getElementById('root').innerHTML=`<a class=\"card\" href=\"${c.url}\" target=\"_blank\"><div class=\"head\"><span class=\"dot\"></span><span class=\"title\">Comment posted${c.file_name?' on '+c.file_name:''}</span></div><div class=\"msg\">${c.message}</div><div class=\"link\">${c.url}</div></a>`}window.openai?.toolOutput&&render(window.openai.toolOutput);window.addEventListener('message',e=>{if(e.data?.type==='ui/notifications/tool-result')render(e.data.params?.structuredContent)});</script></body></html>",
      "_meta": {
        "ui": {
          "domain": "figma-comment.widget.mcp-apps.directory",
          "prefersBorder": true,
          "csp": { "connectDomains": ["api.figma.com"], "resourceDomains": ["s3-alpha.figma.com"] }
        }
      }
    }
  ]
}
